# DocuChat Environment Variables — Free Stack
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ------------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------------

# Your Groq API key — get one FREE (no credit card) at:
#   https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------
# OPTIONAL OVERRIDES (defaults shown)
# ------------------------------------------------------------------

# Groq model for chat completions (free tier includes all of these)
# Options: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
# CHAT_MODEL=llama-3.3-70b-versatile

# Local HuggingFace embedding model (no key needed, runs on CPU)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Text chunking (character-based)
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# Number of chunks to retrieve per query
# TOP_K_RESULTS=4

# Max conversation turns per session
# MAX_HISTORY_TURNS=6

# FAISS index persistence directory
# FAISS_INDEX_PATH=faiss_index

# Server
# HOST=0.0.0.0
# PORT=8000
